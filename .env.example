# Only needed for live generation with --provider openai.
# Copy to .env and load with node --env-file=.env.
OPENAI_API_KEY=
# Responses-compatible API base URL. Leave blank for OpenAI directly.
# For codex-lb use http://127.0.0.1:2455/v1 and its API key above.
OPENAI_BASE_URL=
# Explicitly choose a Responses model you can access; no paid default.
BUILDER_MODEL=

# Live Freya runs also load build-the-builder/env.sh, or set these here.
# FREYA_API_KEY=
# FREYA_BANK_TEAM_KEY=   # Choose one stable secret of at least 16 characters.
# FREYA_WORKSPACE_ID=    # Required if the API key sees multiple workspaces.
# FREYA_API_URL=https://staging-app.freyavoice.ai

# Generation provider: openai (default for generate) or codex (ChatGPT CLI login).
# Explicit --provider overrides this. Keep OPENAI_API_KEY for switching back.
BUILDER_PROVIDER=openai
# Both providers require BUILDER_MODEL (or --model) accessible to that provider.
# Codex setup: install Codex CLI, then `codex login` and choose ChatGPT.

# Optional thinking effort; --reasoning-effort overrides this. Blank uses provider default.
# Model-dependent: none|minimal|low|medium|high|xhigh|max (ultra: Codex only).
BUILDER_REASONING_EFFORT=

# Optional cost overrides in USD per 1M tokens. Each set rate replaces the
# built-in table (src/usage.ts) for that component only, which lets you price a
# model the snapshot has no row for. Any override labels the estimate as an
# `env` price in run records and the inspector, so it is never mistaken for a
# published rate. Omit a variable to keep the table's figure.
# BUILDER_INPUT_PRICE_PER_MTOK=
# BUILDER_CACHED_INPUT_PRICE_PER_MTOK=
# BUILDER_CACHE_WRITE_PRICE_PER_MTOK=
# BUILDER_OUTPUT_PRICE_PER_MTOK=
