{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // The dev server reuses src/ui/server.ts, which keeps explicit .ts imports.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
