{
  "name": "freya-agent-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.8.1"
  },
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint && tsc --noEmit && tsc -p ui/tsconfig.app.json --noEmit && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "demo": "node src/cli.ts build --task fixtures/reschedule.json",
    "generate": "node --env-file-if-exists=.env src/cli.ts freya --json-only",
    "ui": "pnpm run ui:build && node --env-file-if-exists=.env --env-file-if-exists=build-the-builder/env.sh src/cli.ts ui --allow-delete --allow-archive",
    "lint": "oxlint --deny-warnings src tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --fix --deny-warnings src tests",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:dev": "vite --config ui/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "^9.2.8",
    "ai": "^7.0.137",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
