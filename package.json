{
  "name": "freya-agent-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.8.1"
  },
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint && tsc --noEmit && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "demo": "node src/cli.ts build --task fixtures/reschedule.json",
    "suite": "node src/cli.ts suite --tasks fixtures",
    "report": "node src/cli.ts report",
    "doctor": "node src/cli.ts doctor",
    "lint": "oxlint --deny-warnings src tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --fix --deny-warnings src tests"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "5.9.3"
  }
}
